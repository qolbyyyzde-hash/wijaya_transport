# Database
DB_HOST=127.0.0.1
DB_NAME=wijaya_transport
DB_USER=root
DB_PASS=

# Midtrans (sandbox)
MIDTRANS_SERVER_KEY=your_sandbox_server_key
MIDTRANS_CLIENT_KEY=your_sandbox_client_key
MIDTRANS_IS_PRODUCTION=0

# SMTP / Mail (optional - used if PHPMailer installed)
SMTP_HOST=smtp.example.com
SMTP_USER=username
SMTP_PASS=password
SMTP_PORT=587
SMTP_SECURE=tls
MAIL_FROM=no-reply@yourdomain.com

# Admin contact
ADMIN_EMAIL=admin@example.test
